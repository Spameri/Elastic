{
	"name": "spameri/elastic",
	"type": "library",
	"description": "ElasticSearch for Nette Framework",
	"keywords": [
		"nette",
		"spameri",
		"elastic",
		"elasticsearch"
	],
	"homepage": "http://github.com/spameri",
	"license": [
		"BSD-3-Clause",
		"GPL-2.0",
		"GPL-3.0"
	],
	"support": {
		"issues": "https://github.com/spameri/elastic/issues"
	},
	"authors": [
		{
			"name": "Spamer",
			"email": "vcevela@gmail.com"
		}
	],
	"require": {
		"php": ">=8.2",
		"ext-json": "*",
		"ext-curl": "*",
		"spameri/elastic-query": "dev-master",
		"elasticsearch/elasticsearch": "^8.17.0 || ^9.0.0",
		"guzzlehttp/guzzle": "^7.9",
		"nette/di": "^3.1.10",
		"nette/utils": "^4.0.0|^3.2.5",
		"symfony/console": "^7.0.3",
		"tracy/tracy": "^2.9",
		"monolog/monolog": "^3.0.0",
		"ezimuel/ringphp": "^1.2"
	},
	"require-dev": {
		"slevomat/coding-standard": "^8.15.0",
		"spameri/dependency-mocker": "^1.3",
		"nette/tester": "^v2.5.7",
		"phpstan/phpstan": "^1.11.10",
		"php-coveralls/php-coveralls": "^2.1",
		"nette/bootstrap": "^3.1",
		"nette/http": "^3.0.7",
		"mockery/mockery": "^1.5"
	},
	"autoload": {
		"psr-4": {
			"Spameri\\Elastic\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SpameriTests\\": "tests/SpameriTests"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"php-http/discovery": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "2.0-dev"
		}
	},
	"conflict": {
		"nette/neon": "<3.3.4 || >=3.4.0 <3.4.4",
		"symfony/string": "<6.4.3 || >=7.0 <7.0.3",
		"psr/http-factory": "<1.1",
		"symfony/polyfill-mbstring": "<1.3"
	}
}
